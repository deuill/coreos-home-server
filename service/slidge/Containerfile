FROM docker.io/debian:bookworm-slim@sha256:2424c1850714a4d94666ec928e24d86de958646737b1d113f5b2207be44d37d8 AS builder-base

RUN apt-get update -y && apt-get install -y --no-install-recommends \
    ca-certificates git curl python3 python3-pip python3-venv

ENV PATH=/venv/bin:/root/.local/bin:$PATH
ENV UV_PROJECT_ENVIRONMENT=/venv/

RUN python3 -m venv /venv && python3 -m pip install wheel && \
    python3 -m pip install uv

FROM builder-base AS builder-discord

WORKDIR /src

ARG VERSION=0.2.1 # renovate: datasource=git-tags depName=slidcord packageName=https://codeberg.org/slidge/slidcord extractVersion=^v(?<version>.*)$
RUN git clone https://codeberg.org/slidge/slidcord.git /src && \
    git reset --hard v${VERSION}

RUN uv sync --no-dev
RUN cp -R /src/slidcord /venv/lib/python3.11/site-packages/legacy_module

FROM builder-base AS builder-whatsapp

RUN apt-get update -y && apt-get install -y --no-install-recommends \
    gcc python3-dev

RUN echo "deb http://deb.debian.org/debian bookworm-backports main" > /etc/apt/sources.list.d/backports.list && \
    apt-get update -y && apt-get install -y --no-install-recommends -t bookworm-backports golang \
    libmupdf-dev libgumbo-dev libfreetype6-dev libharfbuzz-dev libjbig2dec0-dev libjpeg62-turbo-dev \
    libmujs-dev libopenjp2-7-dev

ENV GOBIN=/usr/bin
RUN go install github.com/go-python/gopy@master && \
    go install golang.org/x/tools/cmd/goimports@master

WORKDIR /src

ARG VERSION=0.2.7 # renovate: datasource=git-tags depName=slidge-whatsapp packageName=https://codeberg.org/slidge/slidge-whatsapp extractVersion=^v(?<version>.*)$
RUN git clone https://codeberg.org/slidge/slidge-whatsapp.git /src && \
    git reset --hard v${VERSION}

RUN uv sync --no-dev
RUN uv pip install pybindgen

WORKDIR /src/slidge_whatsapp
RUN CGO_LDFLAGS="-lgumbo -lfreetype -ljbig2dec -lharfbuzz -ljpeg -lmujs -lopenjp2" \
    gopy build -vm=python3 -output=generated -no-make=true -build-tags="mupdf extlib static" .
RUN cp -R /src/slidge_whatsapp /venv/lib/python3.11/site-packages/legacy_module

FROM docker.io/debian:bookworm-slim@sha256:2424c1850714a4d94666ec928e24d86de958646737b1d113f5b2207be44d37d8
ENV PYTHONUNBUFFERED=1
ENV SLIDGE_LEGACY_MODULE=legacy_module

RUN apt-get update -y && apt-get install -y --no-install-recommends \
    ca-certificates python3 libpython3.11 python3-gdbm libidn12 libmagic1 media-types shared-mime-info \
    ffmpeg libgumbo1 libfreetype6 libharfbuzz0b libjbig2dec0 libjpeg62-turbo libmujs2 libopenjp2-7

RUN addgroup --system --gid 10000 slidge
RUN adduser --system --uid 10000 --ingroup slidge --home /var/lib/slidge slidge

COPY --from=builder-discord /venv /venv/discord
COPY --from=builder-whatsapp /venv /venv/whatsapp

WORKDIR /var/lib/slidge
USER slidge
