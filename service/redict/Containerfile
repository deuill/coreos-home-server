FROM docker.io/debian:bookworm-slim@sha256:4b50eb66f977b4062683ff434ef18ac191da862dbe966961bc11990cf5791a8d
RUN apt-get update -y && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates gettext gosu

ARG VERSION=7.3.2+ds-1~bpo12+1 # renovate: datasource=repology depName=debian_12_backports/redict versioning=loose
RUN echo "deb http://deb.debian.org/debian bookworm-backports main" > /etc/apt/sources.list.d/backports.list && \
    apt-get update -y && apt-get install -y --no-install-recommends -t bookworm-backports \
    redict-server="${VERSION}*"

COPY container/config /etc/redict
USER redict

EXPOSE 6379
ENTRYPOINT ["redict-server", "/etc/redict/redict.conf"]
