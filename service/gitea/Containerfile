FROM docker.io/debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3 AS builder-gitea
ARG VERSION=28.2.0 # renovate: datasource=github-releases depName=go-gitea/gitea extractVersion=^v(?<version>.*)$

ADD https://dl.gitea.io/gitea/${VERSION}/gitea-${VERSION}-linux-amd64 /src/gitea
RUN install -D --mode 0755 /src/gitea /build/usr/bin/gitea

FROM docker.io/golang:1.27-bookworm@sha256:d9b6a1beb9474adc2a1ce842573639b44b2a0dd49b6669f51d3821baf9ec37c9 AS builder-runner
ARG VERSION=5.2.4 # renovate: datasource=gitea-releases depName=gitea/runner extractVersion=^v(?<version>.*)$

ADD https://dl.gitea.com/gitea-runner/${VERSION}/gitea-runner-${VERSION}-linux-amd64 /src/gitea-runner
RUN install -D --mode 0755 /src/gitea-runner /build/usr/bin/gitea-runner

FROM docker.io/debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
RUN apt-get update -y && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates gettext gosu

RUN apt-get update -y && apt-get install -y --no-install-recommends \
    curl git openssh-client gnupg

RUN adduser --system --group --uid 10000 --home /var/lib/gitea git

COPY --from=builder-gitea /build /
COPY --from=builder-runner /build /
COPY container/config /etc/gitea
COPY container/run-gitea /run-gitea
COPY container/run-gitea-actions /run-gitea-actions

EXPOSE 8080 7920
ENTRYPOINT ["/run-gitea"]
